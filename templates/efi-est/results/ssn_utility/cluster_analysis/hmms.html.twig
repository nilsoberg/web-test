
<div>
    <div>
        If the HMM is missing for Node Cluster 1 (and additional clusters with large numbers of
        nodes), repeat the job with a "Maximum Node Count" in the Sequence Filter input window.
        MUSCLE can fail with a "large" number of sequences (variable, anywhere from &gt;750 to
        &gt;1500).
    </div>

    <h4>HMMs</h4>

    <div class="container text-center">
        <div class="row align-items-center">
            <div class="col-3">
                  <a href="{{ page.hmms.zipDownloadUrl }}" class="btn btn-primary btn-sm">Download All (ZIP)</a>
            </div>
            <div class="col-7 text-start">
                HMMs for FASTA cluster (full length sequences)
            </div>
            <div class="col-2">
                {{ page.hmms.zipDownloadSize }}
            </div>
        </div>
    </div>

    <div>
        {% for row in page.hmms.hmms %}
            {% set items = {
                'Full': row.full,
                'Domain': row.domain,
            } %}
            <div>
                <h4>{{ row.clusterName }}</h4>
                <div class="my-2 text-muted">
                    Number of IDs:
                    {% if row.numUniprotIds %}
                        UniProt: {{ row.numUniprotIds }}
                    {% endif %}
                    {% if row.numUniref90Ids %}
                        | UniRef90: {{ row.numUniref90Ids }}
                    {% endif %}
                    {% if row.numUniref50Ids %}
                        | UniRef50: {{ row.numUniref50Ids }}
                    {% endif %}
                </div>

                <div class="container px-0 mt-3">
                    {% for label, item in items %}
                        {% if item %}
                            <div class="mb-2"><b>{{ label }} Sequences</b></div>
                            <div>
                                <a
                                    class="btn btn-sm btn-primary"
                                    href="{{ item.skylignViewerUrl }}"
                                    {{ stimulus_controller('skylign_window', {
                                        'url': item.skylignViewerUrl,
                                        'width': 1500,
                                        'height': 600,
                                    }) }}
                                    data-action="click->skylign-window#open"
                                >Skylign <i class="bi bi-eye-fill"></i></a>
                                <a class="mx-3 btn btn-sm btn-primary" href="{{ item.hmmDownloadUrl }}">HMM <i class="bi bi-download"></i></a>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

