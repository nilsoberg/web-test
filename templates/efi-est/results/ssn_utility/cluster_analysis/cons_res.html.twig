
<div>
    <h4>Consensus Residues</h4>

    <div>
        {% for row in page.consensusResidues %}
            <div>
                <h4 class="text-center">{{ row.residue }}</h4>
                <div class="row align-items-center">
                    <div class="col-2">
                        <a href="{{ row.downloadUrl }}" class="btn btn-primary btn-sm">Download</a>
                    </div>
                    <div class="col-8 text-start">
                        Consensus residue position summary table (full)
                    </div>
                    <div class="col-2">
                        {{ row.downloadSize }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

