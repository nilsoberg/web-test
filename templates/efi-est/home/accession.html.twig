
<div class="job-form-container" data-job-type-config="ESTAccession-form" data-controller="upload-progress">

    <p class="tab-p-heading"> Generate a SSN from a list of UniProt, UniRef, NCBI, or Genbank IDs.</p>

    <div>
        <p>
        An all-by-all BLAST <span data-controller="tooltip" data-bs-toggle="tooltip" title="A BLAST with all retrieved sequences BLAST-ed against the same set of retrieved sequences.">{% include('_partials/question_mark.html.twig') %}</span>
        is performed to obtain the similarities between sequence pairs to calculate edge values to generate the SSN. 
        </p>
    </div>

    {{ form_start(estAccessionForm, {
        'attr': {
            'data-upload-progress-target': 'form',
            'data-action': 'submit->upload-progress#upload'
        }
    }) }}

    <div>
        <div
            id="accession-tabs"
            class="page-tabs"
            data-controller="tabs"
            data-tabs-active-value="{{ accessionActiveInputTab }}"
        >
            <ul>
                <li><a href="#AccessionsTab-uniprot">Use UniProt IDs</a></li>
                <li><a href="#AccessionsTab-uniref">Use UniRef50 or UniRef90 Cluster IDs</a></li>
            </ul>
            <div id="AccessionsTab-uniprot">
                <div>
                     Input a list of UniProt, NCBI, or Genbank (protein) accession IDs, or upload a text file.
                </div>
                <div class="input-description">
                    <div>
                        <div><span class="input-heading">Sequences:</span></div>
                        <div>{{ form_widget(estAccessionForm.textUniprot) }}</div>
                    </div>
                    <div class="submission-error">{{ form_errors(estAccessionForm.textUniprot) }}</div>
                    <div>
                        <div><span class="input-heading">Accession IDs File:</span> {% include('_partials/upload_file_size_tooltip.html.twig') %}</div>
                        <div>{{ form_widget(estAccessionForm.fileUniprot) }}</div>
                    </div>
                    <div class="submission-error">{{ form_errors(estAccessionForm.fileUniprot) }}</div>
                </div>
            </div>
            <div id="AccessionsTab-uniref">
                <div>
                     Input a list of UniRef50 or UniRef90 cluster accession IDs, or upload a text file.
                </div>
                <div class="input-description">
                    <div>
                        <div><span class="input-heading">Sequences:</span></div>
                        <div>{{ form_widget(estAccessionForm.textUniref) }}</div>
                    </div>
                    <div class="submission-error">{{ form_errors(estAccessionForm.textUniref) }}</div>
                    <div>
                        <div><span class="input-heading">Accession IDs File:</span> {% include('_partials/upload_file_size_tooltip.html.twig') %}</div>
                        <div>{{ form_widget(estAccessionForm.fileUniref) }}</div>
                    </div>
                    <div class="submission-error">{{ form_errors(estAccessionForm.fileUniref) }}</div>
                    <div>
                        <span class="input-heading">Input accession IDs are:</span>
                        <span data-controller="tooltip" data-bs-toggle="tooltip" title="The list of sequences that is put into the tool will be end up being the node IDs, and node attributes with the UniRef clusters will be included in the output SSN.">{% include('_partials/question_mark.html.twig') %}</span>
                        <twig:uniref_version form="{{ estAccessionForm }}" useGlobalScope="true" familyFormId="ESTAccession-form" tabTrigger="1" />
                    </div>
                    <div class="submission-error">{{ form_errors(estAccessionForm.unirefVersion) }}</div>
                </div>
            </div>
        </div>
    </div>

    <div id="ESTAccession-form-exclude-fragments" data-controller="accordion" data-accordion-initially-open-value="true">
        <h3>Fragment Option</h3>
        <div class="accordion-content">
            <twig:exclude_fragments form="{{ estAccessionForm.excludeFragments }}" />
        </div>
    </div>

    <div id="ESTAccession-form-tax-search" data-controller="accordion" data-accordion-initially-open-value="true">
        <h3>Filter by Taxonomy</h3>
        <div class="accordion-content">
            {% include('_partials/taxonomy_filtering_text.html.twig') %}

            <twig:taxonomy_filtering filterForm="{{ estAccessionForm.taxSearch }}" />

            {# Ensure that Symfony doesn't render this field later #}
            {% do estAccessionForm.taxSearch.setRendered() %}
        </div>
    </div>

    <div id="ESTAccession-form-filter-by-family" data-controller="accordion" data-accordion-initially-open-value="true">
        <h3>Filter by Family</h3>
        <div class="accordion-content">
            <div>
                <p><b>The input list of UniRef90 or UniRef50 cluster IDs should (must!) be filtered with the same list
                    of Pfam families, InterPro families, and/or Pfam clans used to generate the IDs, if:
                </b></p>
            </div>

            <p>
            The input list of UniRef90 or UniRef50 IDs is obtained from 1) the Color SSN or Cluster Analysis utility for
            a Families option (Option B) EFI-EST SSN, 2) the Families option of the Taxonomy Tool, or 3) the Accession
            IDs option of the Taxonomy Tool.
            </p>

            <p>
            Input a list of Pfam families, InterPro families, and/or Pfam clans to restrict the UniProt and/or UniRef IDs in the SSN to these families.
            </p>

            <div>
                <div>
                    <span class="input-heading">Family(s):</span>
                    {{ form_widget(estAccessionForm.familyFilter) }}
                </div>
                <div class="input-description">
                    The input format is a single
                    family or comma/space separated list of families. Families should be specified as PFxxxxx (five digits),
                    IPRxxxxxx (six digits) or CLxxxx (four digits) for Pfam clans.
                </div>
            </div>

            <p>
            For input lists of UniRef90 and UniRef50 clusters, the cluster ID (representative sequence) is used to
            identify those that match the list of families and are included in the SSN. The UniProt members in these
            clusters that do not match the input families are removed from the cluster and are not included in the SSN
            node attributes.
            </p>
        </div>
    </div>

    <div id="ESTAccession-form-family-input" data-controller="accordion">
        <h3>Protein Family Addition Options</h3>
        <div class="accordion-content">
            <twig:family_input form="{{ estAccessionForm.familyInput }}" formId="ESTAccession-form" tabTrigger="AccessionsTab-uniref" defaultDatabaseId="{{ defaultDatabaseId }}" />
            <div>
                <p>
                UniRef90 clusters contain UniProt IDs that share &ge;90% sequence identity and have 80% overlap
                with the longest sequence in the cluster ("seed sequence"); as a result, the UniProt IDs in
                the cluster usually are functionally homogeneous, i.e., orthologues. UniRef50 clusters contain
                UniProt IDs that share &ge;50% sequence identity and have 80% overlap with the seed sequence;
                as a result, the UniProt IDs in the cluster often are functionally heterogeneous, e.g.,
                paralogues.
                </p>
                <p>
                The sequences from the UniRef90 and UniRef90 databases are the UniRef90 and UniRef50 clusters
                for which the cluster ID ("representative sequence") matches the specified families. The
                UniProt members in these UniRef90 and Uni/Ref50 clusters that do not match the specified
                families are removed from the cluster. 
                </p>
            </div>
        </div>
    </div>

    <div id="ESTAccession-form-domain" data-controller="accordion">
        <h3>Family Domain Boundary Option</h3>
        <div class="accordion-content">
            <twig:domain_input form="{{ estAccessionForm.domainInput }}" />
        </div>
    </div>

    <div id="ESTAccession-form-ssn-edge-calc" data-controller="accordion">
        <h3>SSN Edge Calculation Option</h3>
        <div class="accordion-content">
            <twig:ssn_edge_calc form="{{ estAccessionForm.allByAllBlastEValue }}" />
        </div>
    </div>

    <twig:est_dev_features form="{{ estAccessionForm }}" form_elementid="ESTAccession-form" />

    <div>
        <twig:job_submit_input form="{{ estAccessionForm }}" mainFormId="ESTAccession-form" />
    </div>

    {% include('_partials/file_upload_progress.html.twig') %}

	{{ form_end(estAccessionForm) }}

</div>

