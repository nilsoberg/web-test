
{% set page_subtitle = 'Enzyme Similarity Tool' %}

{% extends "efi-est/core.html.twig" %}


{% set mainActiveTab = 0 %}
{% set nestedActiveTab = -1 %}
{% set nestedTabTarget = '' %}

{% if is_granted('JOB_SUBMISSION') %}
    {% set tabOffset = page.isLoggedIn ? 1 : 0 %}

    {% if page.activeForm %}
        {% if page.activeForm == 'estBlastForm' %}
            {% set mainActiveTab = tabOffset %}
        {% elseif page.activeForm == 'estFamiliesForm' %}
            {% set mainActiveTab = tabOffset + 1 %}
        {% elseif page.activeForm == 'estFastaForm' %}
            {% set mainActiveTab = tabOffset + 2 %}
        {% elseif page.activeForm == 'estAccessionForm' %}
            {% set mainActiveTab = tabOffset + 3 %}
        {% elseif page.activeForm == 'estColorSsnForm' %}
            {% set mainActiveTab = tabOffset + 4 %}
            {% set nestedTabTarget = '#ssn-utilities-tabs' %}
            {% set nestedActiveTab = 0 %}
        {% elseif page.activeForm == 'estCAForm' %}
            {% set mainActiveTab = tabOffset + 4 %}
            {% set nestedTabTarget = '#ssn-utilities-tabs' %}
            {% set nestedActiveTab = 1 %}
        {% elseif page.activeForm == 'estNbConnForm' %}
            {% set mainActiveTab = tabOffset + 4 %}
            {% set nestedTabTarget = '#ssn-utilities-tabs' %}
            {% set nestedActiveTab = 2 %}
        {% elseif page.activeForm == 'estConvRatioForm' %}
            {% set mainActiveTab = tabOffset + 4 %}
            {% set nestedTabTarget = '#ssn-utilities-tabs' %}
            {% set nestedActiveTab = 3 %}
        {% endif %}
    {% endif %}
{% endif %}

{% block content %}

{% include 'efi-est/_partials/intro.html.twig' %}
{% include '_partials/database_info.html.twig' %}
{% include '_partials/app_flashes.html.twig' %}


{#
  Here we set up the tabs page using a custom component that renders the HTML code with both
  stimulus controller code and server-side pre-styling.  Pre-styling prevents flash of unstyled
  content issues.
#}

{% set previousJobsContent %}
    <h3>Previous Jobs</h3>
    {% if page.isLoggedIn and page.userJobs|length > 0 %}
        <twig:user_jobs_summary jobs="{{ page.userJobs }}" sortBy="{{ page.dashboardSortBy }}" sortDir="{{ page.dashboardSortDir }}" />
    {% elseif not page.isLoggedIn and is_app_public_mode %}
        <twig:public_mode_jobs_notice />
    {% else %}
        No jobs are available to view
    {% endif %}
{% endset %}

{# Always show the previous jobs tab #}
{% set homeTabs = [
    { id: 'ESTPreviousJobs', label: 'Previous Jobs', content: previousJobsContent }
] %}

{# Add the other job submission tabs #}
{% if is_granted('JOB_SUBMISSION') %}
    {% set homeTabs = homeTabs|merge([
        { id: 'ESTBlast-form', label: 'BLAST', template: 'efi-est/home/blast.html.twig', context: { defaultDatabaseId: page.defaultDatabaseId } },
        { id: 'ESTFamilies-form', label: 'Families', template: 'efi-est/home/families.html.twig', context: { defaultDatabaseId: page.defaultDatabaseId } },
        { id: 'ESTFasta-form', label: 'FASTA', template: 'efi-est/home/fasta.html.twig', context: { defaultDatabaseId: page.defaultDatabaseId } },
        { id: 'ESTAccession-form', label: 'Accession', template: 'efi-est/home/accession.html.twig', context: { defaultDatabaseId: page.defaultDatabaseId } },
        { id: 'SSNUtilities-tabs', label: 'SSN Utilities', template: 'efi-est/home/ssn_utilities.html.twig' }
    ]) %}
{% endif %}

{# Render all the tabs #}
{% include 'components/tabs_component.html.twig' with {
    tabs: homeTabs,
    activeIndex: mainActiveTab,
    nestedActiveIndex: nestedActiveTab,
    nestedTarget: nestedTabTarget
} %}


{% include 'auth/job/partials/job_info_modal.html.twig' %}
{% endblock %}

{% block scripts %}
{% include 'auth/job/partials/job_info_script.html.twig' %}
{% endblock %}

