{% extends "auth/core.html.twig" %}

{% block auth_content %}
<div class="container" data-controller="job-statistics">
    <h2>Job Statistics</h2>

    <form method="GET" action="{{ path('app_admin_job_list') }}" data-job-statistics-target="form">
        <input type="hidden" name="month" value="{{ currentMonth|date('Y-m', false) }}" data-job-statistics-target="monthInput">

        <div>
            <div>
                <button data-action="click->job-statistics#changeMonth" 
                        data-month="{{ currentMonth|date_modify('-1 month')|date('Y-m', false) }}" 
                        class="btn btn-primary btn-sm">&laquo; Previous Month</button>
                
                <span class="mx-3 fw-bold">{{ currentMonth|date('F Y', false) }}</span>
                
                <button data-action="click->job-statistics#changeMonth" 
                        data-month="{{ currentMonth|date_modify('+1 month')|date('Y-m', false) }}" 
                        class="btn btn-primary btn-sm">Next Month &raquo;</button>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-4">
                <strong>Filter Types: </strong>
                {% for group in availableGroups %}
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="groups[]" value="{{ group }}" 
                               id="filter_{{ group }}"
                               data-action="change->job-statistics#submit"
                               {% if group in selectedGroups %}checked{% endif %}>
                        <label class="form-check-label" for="filter_{{ group }}">{{ group|replace({'_': ' '}) }}</label>
                    </div>
                {% endfor %}
            </div>
        </div>
    </form>

    <table class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th>Job ID</th>
                <th>User Email</th>
                <th>Job Name</th>
                <th>Job Type</th>
                <th>Date Created</th>
                <th>Date Started</th>
                <th>Date Finished</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for job in jobs %}
                <tr>
                    <td>
                        {% if job.viewRoute %}
                            <a href="{{ job.viewRoute }}">{{ job.id }}</a>
                        {% else %}
                            {{ job.id }}
                        {% endif %}
                    </td>
                    <td>
                        <span
                            data-controller="tooltip"
                            data-bs-toggle="tooltip"
                            title="{{ job.userFullName }} | Org: {{ job.userOrganization ? job.userOrganization : 'None' }}" 
                            style="cursor: help; text-decoration: underline dotted;"
                        >
                            {{ job.userEmail }}
                        </span>
                    </td>
                    <td class="text-break" style="max-width: 300px">{{ job.name|default('N/A') }}</td>
                    <td>{{ job.type }}</td>
                    <td>{{ job.timeCreated ? job.timeCreated|date_skeleton('MMMdjm') : '-' }}</td>
                    <td>{{ job.timeStarted ? job.timeStarted|date_skeleton('MMMdjm') : '-' }}</td>
                    <td>{{ job.timeCompleted ? job.timeCompleted|date_skeleton('MMMdjm') : '-' }}</td>
                    <td>
                        <button type="button" class="btn btn-sm view-details-btn btn-{{ job.statusBadgeClass }}" 
                            data-bs-toggle="modal" 
                            data-bs-target="#jobDetailsModal"
                            data-job-id="{{ job.id }}"
                            data-job-details-url="{{ path('admin_job_details', { id: job.id }) }}"
                        >
                            {{ job.status }}
                        </button>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center">No jobs found for this month.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% include 'auth/job/partials/job_info_modal.html.twig' %}
{% endblock %}

{% block scripts %}
{% include 'auth/job/partials/job_info_script.html.twig' %}
{% endblock %}

