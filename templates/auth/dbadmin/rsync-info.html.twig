{% extends 'core/core.html.twig' %}

{% block theme %}

<link rel="stylesheet" href="{{ asset('css/webadmin.css') }}">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

{% endblock %}

{# Left Logo on the Header #}
{% block logoleft %}
    <a href="/">
        <img src="{{ asset('images/efi_logo.png') }}" height="75" alt="Enzyme Function Initiative Logo">
    </a>
{% endblock %}
{# Right Logo on the Header #}
{% block logoright %}
    <a href="https://www.igb.illinois.edu">
        <img src="{{ asset('images/illinois_igb_full.png') }}" height="75" alt="Institute for Genomic Biology at University of Illinois at Urbana-Champaign logo">
    </a>
{% endblock %}

{% block auth_content %}

    <div class="content">

        {% include 'core/header.html.twig' %}

        <div class="container py-4">

            <p class="lead">Use the example command below to securely upload your database files:</p>

            <pre class="bg-light border rounded p-2 text-monospace d-inline-block text-wrap overflow-auto m-0">
                rsync -avz -e "ssh -i {private-key}" {source} {destination}
            </pre>

            <h4 class="mt-4">Parameters:</h4>
            <ul>
                <li><strong>{source}:</strong> /path/to/your/local/database</li>
                <li><strong>{private-key}:</strong> /path/to/rsync_key.pem</li>
                <li><strong>{destination}:</strong> {{ username }}@{{ serverAddress }}:{{ stagingPath }}/</li>
            </ul>

            <div class="my-4">
                <a href="{{ path('dbadmin_rsync_download', {'keyId': keyId}) }}" class="btn btn-outline-success">
                    <i class="bi bi-download"></i> Download Private Key
                </a>
                <a href="{{ path('dbadmin_dashboard') }}" class="btn btn-outline-secondary ms-2">Back to Dashboard</a>
            </div>

            <div class="alert alert-warning mt-3">
                <strong>Note:</strong> Save the SSH key securely. Do not share this key outside your organization. You will not be able to download it again unless you restart the process.
            </div>
        </div>

    </div>

{% endblock %}
