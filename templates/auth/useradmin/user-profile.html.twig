
{% extends "auth/core.html.twig" %}

{% block content %}

{% include '_partials/app_flashes.html.twig' %}

<div class="container">
    {{ user.fullName }}
    <br><br>
    {{ user.email }}
    <br><br>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_row(form.timezone) }}
    {{ form_row(form.sendJobStatusEmail) }}

    <div>
        <button type="submit" class="btn btn-primary">Save Profile</button>
    </div>

    {{ form_end(form) }}
</div>

<div class="container my-3">
    <a href="{{ path('account_change_password') }}" class="btn btn-primary">Change Password</a>
</div>

{% endblock %}
