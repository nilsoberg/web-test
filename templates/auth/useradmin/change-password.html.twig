{% extends "auth/core.html.twig" %}

{% block content %}
<div class="container">
    {% include '_partials/app_flashes.html.twig' %}

    {{ form_start(changePasswordForm, {
        attr: {
            class: 'change-password-form',
            'data-controller': 'change-password'
        }
    }) }}
        <div class="form-group mb-3">
            {{ form_row(changePasswordForm.currentPassword) }}
        </div>

        <div class="change-password-guidance mb-3" aria-live="polite">
            <p class="mb-2">Password rules:</p>
            <ul class="password-rule-list mb-1">
                <li class="password-rule password-rule-pending" data-change-password-target="lengthRule">At least 10 characters</li>
                <li class="password-rule password-rule-pending" data-change-password-target="strengthRule">
                    Password strength: Medium or higher
                    <span class="password-strength-current" data-change-password-target="strengthCurrent">(Current: Very weak)</span>
                </li>
            </ul>
            <p class="password-strength-help mb-0" data-change-password-target="strengthHelp">
                Tip: use a longer password with uncommon words, numbers, and symbols.
            </p>
        </div>

        {% set passwordField = changePasswordForm.passwordFields.plainPassword %}
        {% set newPasswordField = passwordField.first %}
        {% set repeatPasswordField = passwordField.second %}

        <div class="form-group mb-3">
            <button type="button" class="btn btn-secondary" data-action="change-password#generatePassword">Generate Password</button>
            <div class="generated-password-warning mt-2" data-change-password-target="generatedPasswordWarning" hidden>
                Copy and Save your password somewhere before proceeding.
            </div>
        </div>

        <div class="form-group mb-3">
            {{ form_label(newPasswordField) }}
            <div class="input-group">
                {{ form_widget(newPasswordField, {
                    attr: {
                        'data-change-password-target': 'newPasswordInput',
                        'data-action': 'input->change-password#onNewPasswordChange keyup->change-password#onNewPasswordChange change->change-password#onNewPasswordChange'
                    }
                }) }}
                <button
                    type="button"
                    class="btn btn-outline-secondary password-visibility-toggle"
                    data-password-visibility-toggle="new"
                    data-action="change-password#toggleVisibility"
                    aria-label="Show password"
                >
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            {{ form_errors(newPasswordField) }}
        </div>

        <div class="form-group mb-1">
            {{ form_label(repeatPasswordField) }}
            <div class="input-group">
                {{ form_widget(repeatPasswordField, {
                    attr: {
                        'data-change-password-target': 'repeatPasswordInput',
                        'data-action': 'input->change-password#onRepeatPasswordChange keyup->change-password#onRepeatPasswordChange change->change-password#onRepeatPasswordChange'
                    }
                }) }}
                <button
                    type="button"
                    class="btn btn-outline-secondary password-visibility-toggle"
                    data-password-visibility-toggle="repeat"
                    data-action="change-password#toggleVisibility"
                    aria-label="Show password"
                >
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            {{ form_errors(repeatPasswordField) }}
            <div class="password-match-status password-match-status-invalid" data-change-password-target="matchStatus">
                Passwords do not match
            </div>
        </div>

        <div class="form-group mb-3">
            <div class="submission-error">
                {{ form_errors(passwordField) }}
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Update Password</button>
    {{ form_end(changePasswordForm) }}
</div>
{% endblock %}
