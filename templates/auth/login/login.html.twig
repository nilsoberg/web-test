{% extends 'auth/login/base.html.twig' %}

{% block title %}Sign in to EFI Tools{% endblock %}

{% block content %}
<div>
    <h1>Sign in to EFI Tools</h1>
    <h2>Enter your credentials</h2>

    {{ form_start(loginForm) }}
        <div class="form-group">
            {{ form_row(loginForm._username) }}
        </div>
        <div class="form-group">
            {{ form_row(loginForm._password) }}
        </div>

        {% if error %}
        <center><div class="form-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div></center>
        {% endif %}

        {{ form_widget(loginForm.submit) }}

    {{ form_end(loginForm) }}

    <a href="{{ path('app_forgot_password_request') }}" class="reset-password">Forgot your password?</a>
</div>
{% endblock %}

