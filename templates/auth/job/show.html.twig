{% extends "auth/core.html.twig" %}

{% block auth_content %}
<style>
    .container { max-width: 800px; }
    .property-table th { width: 30%; }
</style>

<div class="container my-5">
    <div class="card">
        <div class="card-header">
            <h1 class="h3 mb-0">Job Details</h1>
        </div>
        <div class="card-body">
            <p><strong>ID:</strong> {{ job.id }}</p>
            <p><strong>Type:</strong> <span class="badge bg-info">{{ className }}</span></p>
            <p><strong>Status:</strong> {{ job.formattedStatus }}</p>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h2 class="h4 mb-0">Specific Parameters & Results</h2>
        </div>
        <div class="card-body">
            {% if properties is not empty %}
                <table class="table table-striped table-bordered property-table">
                    <thead class="table-light">
                        <tr>
                            <th>Property</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for name, value in properties %}
                            <tr>
                                <td><strong>{{ name }}</strong></td>
                                <td>
                                    {% if value is same as(true) %}
                                        <span class="badge bg-success">Yes</span>
                                    {% elseif value is same as(false) %}
                                        <span class="badge bg-danger">No</span>
                                    {% elseif value is null %}
                                        <em class="text-muted">Not Set</em>
                                    {% elseif value is iterable %}
                                        {{ value|join(', ') }}
                                    {% else %}
                                        {{ value }}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted">No specific properties found for this job type.</p>
            {% endif %}
        </div>
    </div>

    <a href="{{ path('job_list') }}" class="btn btn-secondary mt-4">
        &larr; Back to List
    </a>
</div>
{% endblock %}

