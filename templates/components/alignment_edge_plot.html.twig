
<div
    data-controller="alignment-edge-plot"
    data-alignment-edge-plot-url-value="{{ data_url }}"
    data-alignment-edge-plot-chart-key-value="edge_count"
    {% if job_number is defined and job_number is not empty %}
        data-alignment-edge-plot-job-number-value="{{ job_number }}"
    {% endif %}
>
    <div
        style="width: 100%; height: 500px;"
        data-alignment-edge-plot-target="plot"
    >
        Loading chart...
    </div>
    <div class="d-flex justify-content-center gap-2 mt-2" data-alignment-edge-plot-target="actions" hidden>
        <button type="button" class="btn btn-primary" data-action="alignment-edge-plot#downloadPng">Download PNG</button>
        <button type="button" class="btn btn-secondary" data-action="alignment-edge-plot#downloadPdf">Download PDF</button>
    </div>
</div>
