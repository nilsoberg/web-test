
<div class="blast-parameters-input">
    <div class="form-group">

        {% if hide_sequence_input is not defined %}
            <div>
                <div><span class="input-heading">UniProt BLAST query e-value:</span></div>
                <div class="input-description">
                    {{ form_widget(form.blastEvalue) }}
                    <label for="{{ form.blastEvalue.vars.id }}" class="form-label">Negative log of e-value for retrieving similar sequences (&ge; 1; default: 5)</label>
                </div>
                <div class="submission-error">{{ form_errors(form.blastEvalue) }}</div>
                {% if hide_description is defined %}
                    <div class="input-description">
                         Input a larger e-value (smaller negative log) to retrieve homologues if the query sequence is short.
                         Input a smaller e-value (larger negative log) to retrieve more similar homologues.
                    </div>
                {% endif %}
            </div>

            <div>
                <div><span class="input-heading">Maximum number of sequences retrieved:</span></div>
                <div class="input-description">
                    {{ form_widget(form.maxBlastSequences) }}
                    <label for="{{ form.maxBlastSequences.vars.id }}" class="form-label">(&le;
                        {{ form.vars.max_blast_sequences ?? "10,000" }}, default {{ form.vars.default_blast_sequences ?? "1,000" }})</label>
                </div>
                <div class="submission-error">{{ form_errors(form.maxBlastSequences) }}</div>
            </div>
        {% endif %}

    </div>
</div>

